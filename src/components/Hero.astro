---
import { home } from '../data/home';
import { site } from '../data/site';
import Icon from './ui/Icon.astro';
import HeroScene from './vue/HeroScene.vue';

const show3d = site.heroModel === 'ulun-danu' || site.heroModel === 'candi-bentar';
const facts = [
  { label: 'Tanggal', value: '18–22 Agu 2026' },
  { label: 'Rute', value: 'Semarang – Bali' },
  { label: 'Prodi', value: 'Informatika' },
  { label: 'Instansi', value: 'UPGRIS' },
];
---

<section id="beranda" class="mx-auto max-w-[1400px] px-4 pb-10 pt-5 md:px-8">
  <div class="grid grid-cols-1 items-center gap-8 pb-8 pt-4 lg:grid-cols-12">
    <div class="flex flex-col justify-center gap-6 lg:col-span-7">
      <div
        class="inline-flex w-fit items-center gap-2 rounded-full border border-brand/15 bg-brand/10 px-4 py-1.5 text-xs font-semibold text-brand"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-[#9ad84f]" aria-hidden="true"></span>
        <span>18–22 Agustus 2026 · Bali</span>
      </div>

      <div>
        <span class="mb-1 block text-xs font-bold uppercase tracking-widest text-brand">
          KKL Informatika UPGRIS 2026
        </span>
        <h1 class="text-3xl font-extrabold leading-[1.15] tracking-tight text-neutral-900 sm:text-4xl md:text-5xl">
          Jelajah Wawasan &amp;<br />
          <span class="text-brand">Pesona Dewata</span>
        </h1>
      </div>

      <p class="max-w-xl text-sm leading-relaxed text-neutral-600 md:text-base">
        Dokumentasi perjalanan KKL mahasiswa Informatika UPGRIS 18–22 Agustus 2026 ke Bali—merangkum
        setiap momen berharga dari ruang produksi industri modern, mengeksplorasi destinasi ikonik,
        hingga menyelami kelestarian budaya nusantara.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="/galeri-dokumentasi"
          class="flex items-center gap-2 rounded-full bg-brand px-7 py-3 text-sm font-medium text-white shadow-md transition-all hover:bg-brand-hover hover:shadow-lg"
        >
          Jelajahi Dokumentasi
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="/jadwal-perjalanan"
          class="rounded-full border border-neutral-300 bg-white px-6 py-3 text-sm font-medium text-neutral-800 shadow-sm transition-all hover:bg-neutral-50"
        >
          Lihat Itinerary
        </a>
      </div>

      <dl class="grid grid-cols-2 gap-3 border-t border-neutral-200/80 pt-4 sm:grid-cols-4">
        {
          facts.map((fact) => (
            <div>
              <dt class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400">
                {fact.label}
              </dt>
              <dd class="text-xs font-bold text-neutral-800 sm:text-sm">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="flex h-full flex-col lg:col-span-5">
      <div class="relative flex w-full flex-col items-center justify-center">
        <div class="mb-2 flex w-full max-w-md items-center justify-between gap-2 px-2">
          <div
            class="inline-flex items-center gap-1.5 rounded-full border border-brand/15 bg-brand/10 px-3 py-1 text-xs font-semibold text-brand"
          >
            <Icon name="sparkle" class="h-3.5 w-3.5" strokeWidth={1.8} />
            3D Model Interaktif
          </div>
          <span class="flex items-center gap-1.5 text-xs font-medium text-neutral-500">
            <span class="inline-block h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
            Candi Ulun Danu Beratan
          </span>
        </div>

        <div class="relative w-full">
          {
            show3d ? (
              <HeroScene client:load model={site.heroModel} />
            ) : (
              <div class="grid h-[360px] place-items-center rounded-3xl border border-neutral-200 bg-white sm:h-[420px]">
                <p class="text-sm text-neutral-500">Visual 3D belum tersedia</p>
              </div>
            )
          }
        </div>

        <p class="mt-2 text-center text-xs font-medium text-neutral-500">
          Visual 3D Ulun Danu Beratan · File ulun-danu.glb
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl pb-2 pt-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        home.stats.map((stat) => (
          <div class="flex items-center justify-between rounded-2xl border border-neutral-200/80 bg-white p-4 shadow-sm transition-transform duration-200 hover:-translate-y-1 sm:rounded-3xl sm:p-5">
            <div class="flex items-baseline gap-2.5">
              <span class="text-3xl font-black tracking-tight text-neutral-900 sm:text-4xl">
                {stat.value}
              </span>
              <div class="leading-tight">
                <span class="block text-sm font-bold text-neutral-800 sm:text-base">{stat.label}</span>
                <span class="text-[11px] font-medium text-neutral-400">{stat.detail}</span>
              </div>
            </div>
            {stat.icon === 'dot' ? (
              <div
                class="h-3.5 w-3.5 rounded-full bg-[#9ad84f] ring-4 ring-[#e9f8d5]"
                aria-hidden="true"
              />
            ) : (
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand/5 text-[#556b2f]">
                <Icon name={stat.icon} class="h-5 w-5" strokeWidth={1.8} />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
