---
import { agenda } from '../data/agenda';
import { anggota } from '../data/members';
import CountUp from './vue/CountUp.vue';

const jumlahKunjungan = agenda
  .flatMap((hari) => hari.item)
  .filter((item) => item.jenis === 'kunjungan').length;

const statistik = [
  { label: 'Hari kegiatan', value: agenda.length, detail: 'Rangkaian perjalanan' },
  { label: 'Pulau', value: 2, detail: 'Jawa dan Bali' },
  { label: 'Kunjungan industri', value: jumlahKunjungan, detail: 'Victoria Care & Balai Diklat' },
  { label: 'Peserta', value: anggota.length, detail: 'Mahasiswa Informatika' },
];
---

<section class="border-y border-line bg-canvas" aria-labelledby="statistik-judul">
  <div class="container-page py-12">
    <h2 id="statistik-judul" class="sr-only">Ringkasan kegiatan</h2>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
      {
        statistik.map((item) => (
          <div>
            <dt class="text-label uppercase text-fg-subtle">{item.label}</dt>
            <dd class="mt-2 text-3xl font-semibold tracking-tight text-fg">
              <CountUp client:visible to={item.value} />
            </dd>
            <p class="mt-1 text-xs text-fg-muted">{item.detail}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>
