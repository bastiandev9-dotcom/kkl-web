---
import { info } from '../data/info';
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';
---

<section id="info" class="scroll-mt-24 py-24 sm:py-28 lg:py-32">
  <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div>
      <SectionHeader
        eyebrow="Informasi"
        title="Bekal sebelum berangkat"
        description="Informasi praktis yang perlu diketahui peserta sebelum mengikuti rangkaian KKL."
        titleId="info-judul"
      />

      <div class="mt-8 rounded-xl border border-line bg-surface p-6">
        <p class="text-label uppercase text-fg-subtle">{info.titikKumpul.label}</p>
        <p class="mt-2 text-h4 text-fg">{info.titikKumpul.nilai}</p>
        <p class="mt-1 text-sm text-fg-muted">{info.titikKumpul.detail}</p>
      </div>

      <div class="mt-4 rounded-xl border border-line bg-surface p-6">
        <p class="text-label uppercase text-fg-subtle">Akomodasi</p>
        <ul class="mt-3 space-y-3">
          {
            info.hotel.map((hotel) => (
              <li class="flex flex-col gap-0.5">
                <span class="text-sm font-medium text-fg">{hotel.nama}</span>
                <span class="text-xs text-fg-muted">{hotel.detail}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 border-t border-line pt-4 text-xs text-fg-muted">
          Dikelola oleh {site.biro}.
        </p>
      </div>
    </div>

    <div>
      <h3 class="text-h3 text-fg">Tips perjalanan</h3>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          info.tips.map((tip, index) => (
            <li class="flex gap-3 rounded-lg border border-line bg-canvas p-4">
              <span
                class="grid h-6 w-6 shrink-0 place-items-center rounded-pill bg-brand-subtle text-[10px] font-semibold text-brand"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-sm leading-relaxed text-fg-muted">{tip}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 rounded-lg border border-warning/30 bg-warning-subtle p-4 text-sm leading-relaxed text-fg">
        {info.catatan}
      </p>
    </div>
  </div>
</section>
