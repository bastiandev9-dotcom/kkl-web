---
import { agenda } from '../data/agenda';
import { destinasi, type KategoriDestinasi } from '../data/destinations';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface PilihanSorotan {
  id: string;
  kategori: KategoriDestinasi;
  label: string;
  tag: string;
  lokasi: string;
  href: string;
}

const pilihan: PilihanSorotan[] = [
  {
    id: 'victoria-care',
    kategori: 'industri',
    label: 'Kunjungan industri',
    tag: 'Manufaktur',
    lokasi: 'Semarang, Jawa Tengah',
    href: '#catatan-victoria-care',
  },
  {
    id: 'kecak',
    kategori: 'budaya',
    label: 'Wisata & budaya',
    tag: 'Pertunjukan',
    lokasi: 'Pantai Pandawa, Badung',
    href: '#destinasi-kecak',
  },
  {
    id: 'ulun-danu',
    kategori: 'wisata',
    label: 'Wisata alam',
    tag: 'Ikon Bali',
    lokasi: 'Bedugul, Tabanan',
    href: '#destinasi-ulun-danu',
  },
];

const sorotan = pilihan.flatMap((item) => {
  const tempat = destinasi.find((destination) => destination.id === item.id);

  if (!tempat) {
    return [];
  }

  const hari = agenda.find((day) => day.nomor === tempat.hari[0]);

  return [{ ...item, tempat, tanggal: hari?.tanggal ?? '' }];
});
---

<section id="eksplorasi" class="scroll-mt-24 border-t border-line/70 py-20 sm:py-24">
  <div class="container-page">
    <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Sorotan agenda</p>
        <h2 class="mt-2 text-h2 text-fg">Eksplorasi perjalanan kami</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-fg-muted md:text-base">
        Tiga persinggahan yang merangkum arah belajar KKL: observasi industri, eksplorasi
        destinasi, dan perjumpaan dengan budaya Bali.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        sorotan.map(({ tempat, kategori, label, tag, lokasi, href, tanggal }) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-surface shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="relative aspect-[4/3] overflow-hidden">
              <PhotoPlaceholder
                label={tempat.nama}
                kategori={kategori}
                showLabel={false}
                className="h-full w-full transition-transform duration-500 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-fg/80 via-fg/20 to-transparent"
                aria-hidden="true"
              />
              <div class="absolute inset-x-4 top-4 flex items-start justify-between gap-3">
                <span class="rounded-full border border-white/20 bg-fg/35 px-3 py-1 text-[11px] font-semibold text-white backdrop-blur-md">
                  {label}
                </span>
                <span class="rounded-full bg-accent px-3 py-1 text-[11px] font-bold text-fg">
                  {tag}
                </span>
              </div>
              <div class="absolute inset-x-5 bottom-4">
                <h3 class="text-xl font-bold text-white">{tempat.nama}</h3>
                <p class="mt-1 text-xs text-white/75">{lokasi}</p>
              </div>
            </div>

            <div class="flex flex-1 flex-col justify-between p-6">
              <p class="text-sm leading-relaxed text-fg-muted">{tempat.deskripsi}</p>
              <div class="mt-5 flex items-center justify-between gap-4 border-t border-line/80 pt-4 text-xs text-fg-muted">
                <span class="flex items-center gap-1.5">
                  <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="3"></rect>
                    <path d="M8 3v4M16 3v4M3 10h18" stroke-linecap="round"></path>
                  </svg>
                  {tanggal} 2026
                </span>
                <a href={href} class="flex items-center gap-1 font-semibold text-brand transition-transform group-hover:translate-x-0.5">
                  Lihat detail
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
