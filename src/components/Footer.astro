---
import { site } from '../data/site';

const links = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#agenda', label: 'Agenda' },
  { href: '#rute', label: 'Rute' },
  { href: '#destinasi', label: 'Destinasi' },
  { href: '#dokumentasi', label: 'Dokumentasi' },
  { href: '#anggota', label: 'Anggota' },
  { href: '#info', label: 'Info' },
];
---

<footer class="border-t border-line bg-surface">
  <div class="container-page py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-md bg-brand text-xs font-semibold text-on-brand">
            KKL
          </span>
          <span class="text-sm font-semibold text-fg">{site.title}</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">
          {site.kelompok} · {site.prodi}, {site.kampus}.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-pill border border-line bg-canvas px-3 py-1 text-[11px] font-medium text-fg-muted">
            UPGRIS
          </span>
          <span class="rounded-pill border border-line bg-canvas px-3 py-1 text-[11px] font-medium text-fg-muted">
            UPGRI Tour &amp; Travel
          </span>
        </div>

        {site.dosenPembimbing && (
          <p class="mt-4 text-sm text-fg-muted">
            Dosen pembimbing:
            <span class="font-medium text-fg">{site.dosenPembimbing}</span>
          </p>
        )}
      </div>

      <nav aria-label="Navigasi footer">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-fg-muted transition-colors hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-line pt-6 text-xs text-fg-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 {site.prodi}, {site.kampus}.</p>
      <div class="flex flex-wrap items-center gap-4">
        <span>Model 3D: Ulun Danu · Candi Bentar · Patung Pandawa</span>
        <a href="/credits" class="transition-colors hover:text-fg">Kredit aset 3D</a>
        <a href="#beranda" class="transition-colors hover:text-fg">Kembali ke atas</a>
      </div>
    </div>
  </div>
</footer>
