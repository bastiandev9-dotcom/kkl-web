---
import { site } from '../data/site';
import GlbStage from './vue/GlbStage.vue';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

const show3d = site.heroModel === 'ulun-danu' || site.heroModel === 'candi-bentar';
const facts = [
  { label: 'Tanggal', value: site.tanggal },
  { label: 'Rute', value: 'Semarang - Bali' },
  { label: 'Prodi', value: 'Informatika' },
  { label: 'Biro', value: site.biro },
];
---

<section id="beranda" class="relative scroll-mt-24 overflow-hidden border-b border-line bg-surface">
  <div
    class="pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-accent/30 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-48 -left-40 h-[30rem] w-[30rem] rounded-full bg-brand/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative grid gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:py-28">
    <div>
      <p class="inline-flex items-center gap-2 rounded-pill border border-brand/20 bg-canvas px-3 py-1.5 text-xs font-medium text-brand">
        <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
        18-22 Agustus 2026 · Bali
      </p>

      <h1 class="mt-5 max-w-3xl text-balance text-display text-fg">
        KKL Bali Informatika 2026
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-fg-muted">
        Jejak belajar lima hari dari Semarang ke Bali: belajar dari industri, menjelajah destinasi,
        dan mengenal budaya setempat.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#agenda"
          class="inline-flex items-center rounded-pill bg-brand px-5 py-3 text-sm font-medium text-on-brand transition-colors hover:bg-brand-hover"
        >
          Lihat agenda
        </a>
        <a
          href="#dokumentasi"
          class="inline-flex items-center rounded-pill border border-line bg-canvas px-5 py-3 text-sm font-medium text-fg transition-colors hover:bg-surface-hover"
        >
          Dokumentasi
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-4">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-fg-subtle">{fact.label}</dt>
              <dd class="mt-1 text-sm font-medium text-fg">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      {site.dosenPembimbing && (
        <p class="mt-4 text-sm text-fg-muted">
          Dosen pembimbing:
          <span class="font-medium text-fg">{site.dosenPembimbing}</span>
        </p>
      )}
    </div>

    <div class="relative">
      <div class="mx-auto w-full max-w-sm lg:max-w-none">
        {
          show3d ? (
            <GlbStage client:visible model={site.heroModel} />
          ) : (
            <PhotoPlaceholder
              label="Ulun Danu Beratan"
              kategori="wisata"
              className="aspect-square w-full rounded-2xl border border-line"
            />
          )
        }
        <p class="mt-3 text-center text-xs text-fg-subtle">
          Visual 3D Ulun Danu Beratan
        </p>
      </div>
    </div>
  </div>
</section>
