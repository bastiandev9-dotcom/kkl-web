---
import { home } from '../data/home';
import Icon from './ui/Icon.astro';
---

<section id="jadwal" class="border-y border-neutral-200/60 bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <span class="mb-2 block text-xs font-bold uppercase tracking-widest text-brand">Rencana Itinerary</span>
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-neutral-900 md:text-4xl">
        Jadwal 5 Hari Kegiatan KKL
      </h2>
      <p class="text-sm text-neutral-500 md:text-base">
        Susunan agenda terintegrasi mulai dari keberangkatan kampus, studi lapangan teknologi, hingga
        jelajah kebudayaan di pulau Bali.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-5">
      {
        home.itinerary.map((day) => (
          <div class="relative flex flex-col justify-between rounded-2xl border border-neutral-200 bg-[#fafaf4] p-6 shadow-sm transition-colors hover:border-brand/50">
            <div>
              <div class="mb-4 flex items-center justify-between gap-2">
                <span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-bold text-brand">
                  {day.day}
                </span>
                <span class="text-xs text-neutral-400">{day.date}</span>
              </div>
              <h3 class="mb-2 text-base font-bold text-neutral-900">{day.title}</h3>
              <p class="text-xs leading-relaxed text-neutral-500">{day.description}</p>
            </div>
            <div class="mt-6 flex items-center gap-1 border-t border-neutral-200 pt-3 text-xs font-semibold text-brand">
              <Icon name={day.icon} class="h-3.5 w-3.5" strokeWidth={1.8} />
              {day.activity}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
