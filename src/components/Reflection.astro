---
import { home } from '../data/home';
import { site } from '../data/site';
---

<section id="refleksi" class="mx-auto max-w-7xl px-6 py-24">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <span class="mb-2 block text-xs font-bold uppercase tracking-widest text-brand">Refleksi KKL</span>
      <h2 class="mb-5 text-3xl font-extrabold tracking-tight text-neutral-900 md:text-4xl">
        Menghubungkan Teori Kampus dengan Realitas Lapangan
      </h2>
      <p class="mb-8 text-sm leading-relaxed text-neutral-600 md:text-base">
        Kegiatan Kuliah Kerja Lapangan memberikan pengalaman empiris bagi mahasiswa Informatika untuk
        memahami arsitektur sistem informasi di pabrik modern sekaligus mengagumi nilai-nilai sosial
        budaya nusantara.
      </p>
      <div class="flex items-center gap-4 rounded-2xl border border-brand/15 bg-brand/5 p-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand text-lg font-bold text-white">
          IF
        </div>
        <div>
          <div class="text-sm font-bold text-neutral-900">{site.prodi}</div>
          <div class="text-xs text-neutral-500">{site.kampus} (UPGRIS)</div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-7">
      {
        home.reflections.map((item) => (
          <div class="flex flex-col justify-between rounded-2xl border border-neutral-200 bg-white p-7 shadow-soft">
            <p class="mb-6 text-sm italic leading-relaxed text-neutral-700">"{item.quote}"</p>
            <div class="flex items-center gap-3">
              <div
                class:list={[
                  'flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold',
                  item.tone === 'accent' ? 'bg-accent/60 text-brand' : 'bg-brand text-white',
                ]}
              >
                {item.initials}
              </div>
              <div>
                <h3 class="text-sm font-bold text-neutral-900">{item.name}</h3>
                <span class="text-xs text-neutral-400">{item.role}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
