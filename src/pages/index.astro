---
import Base from '../layouts/Base.astro';
import SetupStatus from '../components/vue/SetupStatus.vue';
import { site } from '../data/site';

const tokens = [
  { name: 'Brand', value: '#4a6741', swatch: 'bg-brand' },
  { name: 'Accent', value: '#d9f18a', swatch: 'bg-accent' },
  { name: 'Surface', value: '#f8f9fa', swatch: 'bg-surface' },
  { name: 'Foreground', value: '#1a1a1a', swatch: 'bg-fg' },
];

const heroGradient =
  'radial-gradient(circle at 18% 18%, rgb(217 241 138 / 0.22), transparent 45%), radial-gradient(circle at 82% 8%, rgb(255 255 255 / 0.14), transparent 40%)';
---

<Base>
  <main id="konten" class="min-h-dvh overflow-hidden">
    <section class="relative isolate overflow-hidden bg-brand text-on-brand">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style={`background-image: ${heroGradient};`}
        aria-hidden="true"
      >
      </div>
      <div class="mx-auto flex min-h-[78dvh] max-w-content flex-col justify-center px-page-x py-section">
        <p class="text-label uppercase text-accent">Dokumentasi KKL · {site.prodi}</p>
        <h1 class="mt-6 max-w-4xl text-balance text-display">{site.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-brand/80">
          {site.rute} · {site.tanggal}. Website ini akan memuat agenda, destinasi, catatan
          kunjungan industri, dan dokumentasi kegiatan.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#agenda"
            class="inline-flex items-center justify-center rounded-pill bg-accent px-6 py-3 text-sm font-medium text-fg transition-colors duration-200 hover:bg-accent-hover focus-visible:outline-none focus-visible:shadow-focus"
          >
            Lihat Agenda
          </a>
          <a
            href="#dokumentasi"
            class="inline-flex items-center justify-center rounded-pill border border-white/30 bg-white/10 px-6 py-3 text-sm font-medium text-on-brand backdrop-blur-sm transition-colors duration-200 hover:bg-white/20 focus-visible:outline-none focus-visible:shadow-focus"
          >
            Dokumentasi
          </a>
        </div>
        <p class="mt-10 text-sm text-on-brand/60">
          {site.kampus} · Biro perjalanan UPGRI Tour &amp; Travel
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-content px-page-x py-section" aria-labelledby="status-fase">
      <p class="text-label uppercase text-fg-muted">Fase 0</p>
      <h2 id="status-fase" class="mt-3 text-h2">Fondasi tampilan siap</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-fg-muted">
        Halaman sementara ini memverifikasi token warna, tipografi, radius, dan spacing. Konten
        lengkap akan dibangun pada fase berikutnya.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {tokens.map((token) => (
          <li class="rounded-xl border border-line bg-surface p-card shadow-xs">
            <div class={`h-16 rounded-lg ${token.swatch}`} aria-hidden="true"></div>
            <p class="mt-4 text-sm font-medium text-fg">{token.name}</p>
            <p class="mt-1 text-sm text-fg-muted">{token.value}</p>
          </li>
        ))}
      </ul>
      <SetupStatus client:visible />
    </section>
  </main>
</Base>
