---
import { rute, type JenisRute } from '../data/route';

const dotClass: Record<JenisRute, string> = {
  awal: 'border-brand bg-brand text-on-brand',
  kota: 'border-brand/25 bg-brand-subtle text-brand',
  pelabuhan: 'border-brand bg-canvas text-brand',
  tujuan: 'border-accent-hover bg-accent text-fg',
  akhir: 'border-brand bg-brand text-on-brand',
};

const jenisLabel: Record<JenisRute, string> = {
  awal: 'Mulai',
  kota: 'Kota transit',
  pelabuhan: 'Pelabuhan',
  tujuan: 'Destinasi',
  akhir: 'Selesai',
};
---

<section id="rute" class="scroll-mt-24 py-20 sm:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Perjalanan</p>
        <h2 id="rute-judul" class="mt-2 text-h2 text-fg">Dari Semarang ke Bali</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted sm:text-base">
          Rute darat dan penyeberangan Selat Bali yang menghubungkan kampus dengan destinasi
          kegiatan.
        </p>
      </div>
      <p class="shrink-0 self-start rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-fg-muted">
        9 titik perjalanan
      </p>
    </div>

    <div class="mt-10 rounded-3xl border border-line bg-surface p-6 shadow-soft sm:p-8">
      <ol class="grid gap-0 lg:grid-cols-9">
        {
          rute.map((langkah, index) => (
            <li class="relative pb-8 pl-12 last:pb-0 lg:pb-0 lg:pl-0 lg:text-center">
              <span
                class={`absolute left-0 top-0 z-10 grid h-9 w-9 place-items-center rounded-full border text-[10px] font-semibold tabular-nums lg:left-1/2 lg:-translate-x-1/2 ${dotClass[langkah.jenis]}`}
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              {index < rute.length - 1 && (
                <span
                  class="absolute left-[1.125rem] top-9 h-[calc(100%-1.125rem)] w-px bg-line lg:left-1/2 lg:top-[1.125rem] lg:h-px lg:w-full"
                  aria-hidden="true"
                />
              )}

              <div class="lg:pt-14">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-fg-subtle">
                  {jenisLabel[langkah.jenis]}
                </p>
                <h3 class="mt-1 text-sm font-bold text-fg">{langkah.label}</h3>
                <p class="mt-1 text-xs leading-relaxed text-fg-muted">{langkah.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-fg-muted">
      Rangkaian perjalanan mencakup lima hari, dua kunjungan industri, dan penyeberangan
      Ketapang-Gilimanuk.
    </p>
  </div>
</section>
