---
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import MobileMenu from './vue/MobileMenu.vue';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeHref =
  navigation.find((link) =>
    link.href === '/' ? pathname === '/' : pathname === link.href || pathname.startsWith(`${link.href}/`),
  )?.href ?? '';
---

<header class="sticky top-0 z-50 border-b border-neutral-200/60 bg-[#fafaf4]/90 backdrop-blur-md">
  <nav
    class="mx-auto flex h-20 max-w-[1400px] items-center justify-between px-6 lg:px-12"
    aria-label="Navigasi utama"
  >
    <a href="/" class="flex shrink-0 items-center rounded-lg py-1" aria-label={`${site.brand} - beranda`}>
      <span class="text-xl font-black tracking-wider text-brand md:text-2xl">{site.brand}</span>
    </a>

    <ul class="hidden items-center gap-1 text-sm font-medium lg:flex">
      {
        navigation.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={activeHref === link.href ? 'page' : undefined}
              class:list={[
                'block rounded-full px-4 py-2 transition-all xl:px-5',
                activeHref === link.href
                  ? 'bg-[#dbe8d8] font-semibold text-brand'
                  : 'text-neutral-600 hover:bg-black/5 hover:text-brand',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden shrink-0 items-center gap-3 lg:flex">
      <a
        href="/jadwal-perjalanan"
        class="rounded-full border border-neutral-300 px-6 py-2.5 text-sm font-medium text-neutral-800 transition-all hover:border-brand hover:bg-brand/5 hover:text-brand"
      >
        Lihat Jadwal
      </a>
    </div>

    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-full border border-neutral-300 bg-white text-neutral-800 lg:hidden"
      aria-label="Buka menu"
      aria-controls="menu-seluler"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </nav>
</header>

<MobileMenu client:load links={navigation} activeHref={activeHref} />
