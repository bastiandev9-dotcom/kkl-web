---
import MobileMenu from './vue/MobileMenu.vue';

const links = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#agenda', label: 'Agenda' },
  { href: '#rute', label: 'Rute' },
  { href: '#destinasi', label: 'Destinasi' },
  { href: '#dokumentasi', label: 'Dokumentasi' },
  { href: '#anggota', label: 'Anggota' },
  { href: '#info', label: 'Info' },
];
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-lg">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="#beranda" class="flex items-center gap-3" aria-label="KKL Bali Informatika 2026 — beranda">
      <span class="grid h-9 w-9 place-items-center rounded-md bg-brand text-xs font-semibold tracking-wide text-on-brand">
        KKL
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-semibold text-fg">KKL Bali 2026</span>
        <span class="block text-[11px] text-fg-muted">Informatika UPGRIS</span>
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Navigasi utama">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <a
        href="#agenda"
        class="inline-flex items-center rounded-pill bg-brand px-4 py-2.5 text-sm font-medium text-on-brand transition-colors hover:bg-brand-hover"
      >
        Lihat agenda
      </a>
    </div>

    <button
      type="button"
      class="grid h-10 w-10 place-items-center rounded-md border border-line text-fg lg:hidden"
      aria-label="Buka menu"
      aria-controls="menu-seluler"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<MobileMenu client:load links={links} />
