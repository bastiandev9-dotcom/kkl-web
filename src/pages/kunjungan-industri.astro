---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import VisitShowcase from '../components/kunjungan/VisitShowcase.astro';
import VisitMap from '../components/kunjungan/VisitMap.astro';
import CompetencySection from '../components/kunjungan/CompetencySection.astro';
import ReadinessSection from '../components/kunjungan/ReadinessSection.astro';
import ReportCta from '../components/kunjungan/ReportCta.astro';
import { kunjungan } from '../data/kunjungan';

const { hero, filters, visits } = kunjungan;
---

<Base
  title="Kunjungan Industri"
  description="Dokumentasi kunjungan industri dan observasi lapangan KKL Bali Prodi Informatika UPGRIS 18-22 Agustus 2026."
>
  <Navbar />
  <main id="konten">
    <section class="px-4 pb-14 pt-10 sm:px-6 sm:pb-16 sm:pt-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
          <div class="max-w-3xl">
            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand/15 bg-brand/10 px-3.5 py-1.5 text-xs font-semibold text-brand">
              <Icon name="factory" class="h-4 w-4" strokeWidth={1.8} />
              {hero.eyebrow}
            </div>
            <h1 class="mb-4 text-4xl font-bold leading-[1.1] tracking-tight text-neutral-900 sm:text-5xl">
              {hero.title}
            </h1>
            <p class="max-w-2xl text-sm leading-relaxed text-neutral-600 sm:text-base">
              {hero.description}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-5 rounded-2xl bg-[#f4f4ee] p-5 shadow-sm sm:gap-6 sm:p-6 lg:shrink-0">
            {
              hero.metrics.map((metric, index) => (
                <div class="flex items-center gap-5 sm:gap-6">
                  {index > 0 && <span class="h-10 w-px bg-[#d8d8cf]" aria-hidden="true" />}
                  <div class="flex flex-col">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">
                      {metric.label}
                    </span>
                    <span class="mt-0.5 text-lg font-bold text-brand sm:text-xl">
                      {metric.value}
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter kunjungan">
          {
            filters.map((filter, index) => (
              <button
                type="button"
                class="filter-pill rounded-full bg-[#f4f4ee] px-4 py-2.5 text-xs font-semibold text-neutral-700 transition-all hover:bg-[#eeeee8] active:scale-[0.98] sm:px-5 sm:text-sm"
                data-filter={filter.value}
                data-active={index === 0 ? 'true' : 'false'}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <div>
      {
        visits.map((visit) =>
          visit.layout === 'map' ? (
            <VisitMap visit={visit} />
          ) : (
            <VisitShowcase visit={visit} />
          ),
        )
      }
    </div>

    <CompetencySection />
    <ReadinessSection />
    <ReportCta />
  </main>
  <Footer />
</Base>

<style>
  .filter-pill[data-active='true'] {
    background: var(--color-brand);
    color: var(--color-on-brand);
    box-shadow: var(--shadow-sm);
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const visitCards = document.querySelectorAll<HTMLElement>('[data-visit]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'semua';

      filterButtons.forEach((item) => {
        const active = item === button;
        item.dataset.active = String(active);
        item.setAttribute('aria-pressed', String(active));
      });

      visitCards.forEach((card) => {
        card.hidden = filter !== 'semua' && card.dataset.category !== filter;
      });
    });
  });
</script>
