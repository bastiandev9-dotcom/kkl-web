---
import type { Visit } from '../../data/kunjungan';
import Icon from '../ui/Icon.astro';

interface Props {
  visit: Visit;
}

const { visit } = Astro.props;
const reverse = visit.reverse ?? false;
const ctaClass =
  visit.cta?.tone === 'accent'
    ? 'bg-accent text-brand-dark hover:bg-accent-hover'
    : 'bg-brand text-white hover:bg-brand-hover';
---

<section
  id={visit.id}
  class="scroll-mt-28 px-4 py-6 sm:px-6 sm:py-8"
  data-visit
  data-category={visit.category}
  aria-labelledby={`${visit.id}-title`}
>
  <div class="mx-auto max-w-7xl">
    <article
      class:list={[
        'rounded-[2rem] p-5 shadow-soft sm:p-8 lg:p-12',
        visit.muted ? 'bg-[#f4f4ee]' : 'bg-white',
      ]}
    >
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
        <div
          class:list={[
            'relative group lg:col-span-7',
            reverse ? 'lg:order-2' : 'lg:order-1',
          ]}
        >
          <div class="relative h-[320px] overflow-hidden rounded-2xl sm:h-[420px] lg:h-[480px]">
            <img
              src={visit.image}
              alt={visit.imageAlt}
              width="512"
              height="279"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/5 to-transparent"
              aria-hidden="true"
            ></div>

            <div
              class:list={[
                'absolute top-4 sm:top-5',
                visit.badgePosition === 'right' ? 'right-4 sm:right-5' : 'left-4 sm:left-5',
              ]}
            >
              <span
                class="inline-flex rounded-full bg-brand/90 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-md"
              >
                {visit.categoryLabel}
              </span>
            </div>

            {
              visit.imageTitle ? (
                <div class="absolute bottom-5 left-5 right-5 text-white">
                  <p class="text-lg font-semibold">{visit.imageTitle}</p>
                  <p class="mt-0.5 text-xs text-white/75">{visit.imageSubtitle}</p>
                </div>
              ) : (
                <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-3 text-white sm:bottom-5 sm:left-5 sm:right-5">
                  <span class="flex items-center gap-2 text-xs font-medium sm:text-sm">
                    <Icon name="clock" class="h-4 w-4" strokeWidth={1.8} />
                    {visit.date}
                  </span>
                  <span class="rounded-full bg-black/40 px-3 py-1 text-[10px] font-medium uppercase tracking-wider backdrop-blur-sm sm:text-xs">
                    {visit.meta}
                  </span>
                </div>
              )
            }
          </div>
        </div>

        <div
          class:list={[
            'flex flex-col justify-center lg:col-span-5',
            reverse ? 'lg:order-1' : 'lg:order-2',
          ]}
        >
          <div class="mb-2 flex items-center gap-2 text-sm font-semibold text-brand">
            <Icon name={visit.eyebrowIcon} class="h-4 w-4" strokeWidth={1.8} />
            <span>{visit.eyebrow}</span>
          </div>

          <h2
            id={`${visit.id}-title`}
            class="mb-4 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl"
          >
            {visit.title}
          </h2>

          <p class="mb-6 text-sm leading-relaxed text-neutral-600 sm:text-base">
            {visit.description}
          </p>

          <div class="mb-8 space-y-3">
            {
              visit.insights.map((insight) => (
                <div
                  class:list={[
                    'flex items-start gap-3 rounded-xl p-4',
                    visit.muted ? 'bg-white' : 'bg-[#f4f4ee]',
                  ]}
                >
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
                    <Icon name={insight.icon} class="h-4 w-4" strokeWidth={1.8} />
                  </span>
                  <div>
                    <h3 class="text-sm font-semibold leading-snug text-neutral-900">
                      {insight.title}
                    </h3>
                    <p class="mt-1 text-xs leading-relaxed text-neutral-500">
                      {insight.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="mb-6 flex flex-wrap gap-2">
            {
              visit.tags.map((tag) => (
                <span class="rounded-full bg-[#e9e8e3] px-3 py-1 text-xs font-medium text-neutral-600">
                  {tag}
                </span>
              ))
            }
          </div>

          {
            visit.cta && (
              <a
                href={visit.cta.href}
                class:list={[
                  'inline-flex w-fit items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-sm transition-all hover:shadow-md',
                  ctaClass,
                ]}
              >
                <span>{visit.cta.label}</span>
                <Icon name={visit.cta.icon} class="h-4 w-4" strokeWidth={1.8} />
              </a>
            )
          }
        </div>
      </div>
    </article>
  </div>
</section>
