---
import { kunjungan } from '../../data/kunjungan';
import Icon from '../ui/Icon.astro';

const { report } = kunjungan;
---

<section id="unduh-laporan" class="scroll-mt-28 px-4 pb-16 pt-8 sm:px-6 sm:pb-20">
  <div class="mx-auto max-w-7xl">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand to-brand-dark p-7 text-white shadow-floating sm:p-10 lg:p-16">
      <div
        class="pointer-events-none absolute -bottom-24 -right-20 h-80 w-80 rounded-full bg-accent/20 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -left-20 -top-24 h-80 w-80 rounded-full bg-white/10 blur-2xl"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-2xl">
        <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/15 px-3.5 py-1.5 text-xs font-semibold backdrop-blur-md">
          <Icon name="download" class="h-4 w-4" strokeWidth={1.8} />
          {report.eyebrow}
        </span>

        <h2 class="mb-4 text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">
          {report.title}
        </h2>
        <p class="mb-8 text-sm leading-relaxed text-white/75 sm:text-base">
          {report.description}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-brand-dark shadow-md transition-colors hover:bg-accent-hover sm:px-7"
            data-report-download
          >
            <Icon name="download" class="h-4 w-4" strokeWidth={1.9} />
            {report.downloadLabel}
          </button>
          <a
            href={report.secondaryHref}
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/20 sm:px-7"
          >
            {report.secondaryLabel}
            <Icon name="arrow-right" class="h-4 w-4" strokeWidth={1.8} />
          </a>
        </div>
        <p class="mt-3 hidden text-xs text-white/70" data-report-status aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-report-download]').forEach((button) => {
    button.addEventListener('click', () => {
      const status = button.parentElement?.parentElement?.querySelector<HTMLElement>(
        '[data-report-status]',
      );

      if (!status) {
        return;
      }

      status.textContent = 'Laporan lengkap sedang disiapkan dan akan tersedia setelah KKL selesai.';
      status.classList.remove('hidden');
    });
  });
</script>
