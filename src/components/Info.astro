---
import { info } from '../data/info';
import { site } from '../data/site';
---

<section id="info" class="scroll-mt-24 border-y border-line/70 bg-surface py-20 sm:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div>
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Informasi</p>
      <h2 id="info-judul" class="mt-2 text-h2 text-fg">Bekal sebelum berangkat</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted sm:text-base">
        Informasi praktis yang perlu diketahui peserta sebelum mengikuti rangkaian KKL.
      </p>

      <div class="mt-8 rounded-3xl border border-line bg-canvas p-6 shadow-soft">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-fg-subtle">
          {info.titikKumpul.label}
        </p>
        <p class="mt-2 text-h4 text-fg">{info.titikKumpul.nilai}</p>
        <p class="mt-1 text-sm text-fg-muted">{info.titikKumpul.detail}</p>
      </div>

      <div class="mt-4 rounded-3xl border border-line bg-canvas p-6 shadow-soft">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-fg-subtle">Akomodasi</p>
        <ul class="mt-3 space-y-3">
          {
            info.hotel.map((hotel) => (
              <li class="flex flex-col gap-0.5">
                <span class="text-sm font-semibold text-fg">{hotel.nama}</span>
                <span class="text-xs text-fg-muted">{hotel.detail}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 border-t border-line pt-4 text-xs text-fg-muted">
          Dikelola oleh {site.biro}.
        </p>
      </div>
    </div>

    <div>
      <h3 class="text-h3 text-fg">Tips perjalanan</h3>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          info.tips.map((tip, index) => (
            <li class="flex gap-3 rounded-2xl border border-line bg-canvas p-4">
              <span
                class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand/10 text-[10px] font-bold text-brand"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-sm leading-relaxed text-fg-muted">{tip}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 rounded-2xl border border-warning/30 bg-warning-subtle p-4 text-sm leading-relaxed text-fg">
        {info.catatan}
      </p>
    </div>
  </div>
</section>
