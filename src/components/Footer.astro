---
import { navigation } from '../data/navigation';
import { site } from '../data/site';

const detailLinks = [
  { href: '#tentang', label: 'Tentang KKL' },
  { href: '#rute', label: 'Rute perjalanan' },
  { href: '#anggota', label: 'Anggota kelompok' },
  { href: '#info', label: 'Informasi peserta' },
];
---

<footer class="mt-8 border-t border-line bg-surface pb-10 pt-14">
  <div class="container-page">
    <div class="grid gap-10 pb-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="md:col-span-2 lg:col-span-2">
        <a href="#beranda" class="inline-flex items-center gap-2 rounded-lg">
          <span class="text-xl font-black tracking-[0.08em] text-brand">{site.brand}</span>
          <span class="rounded-full border border-line bg-canvas px-2 py-0.5 text-[10px] font-semibold text-fg-muted">
            2026
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-fg-muted">
          Portal dokumentasi Kuliah Kerja Lapangan {site.prodi}, {site.kampus}. Menghubungkan
          pengalaman industri, destinasi, dan budaya dalam satu catatan perjalanan.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-full border border-line bg-canvas px-3 py-1 text-[11px] font-medium text-fg-muted">
            {site.tanggal}
          </span>
          <span class="rounded-full border border-line bg-canvas px-3 py-1 text-[11px] font-medium text-fg-muted">
            {site.rute}
          </span>
        </div>
      </div>

      <div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.16em] text-fg">Eksplorasi</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-fg-muted">
          {
            navigation.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-brand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.16em] text-fg">Informasi</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-fg-muted">
          {
            detailLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-brand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-xs leading-relaxed text-fg-subtle">
          Diselenggarakan bersama {site.biro}.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-line pt-6 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; 2026 {site.brand} - {site.prodi}, {site.kampus}.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/credits" class="transition-colors hover:text-brand">Kredit aset 3D</a>
        <a href="#beranda" class="transition-colors hover:text-brand">Kembali ke atas</a>
      </div>
    </div>
  </div>
</footer>
