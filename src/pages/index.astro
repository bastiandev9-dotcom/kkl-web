---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import About from '../components/About.astro';
import Agenda from '../components/Agenda.astro';
import RouteStepper from '../components/RouteStepper.astro';
import Destinations from '../components/Destinations.astro';
import Documentation from '../components/Documentation.astro';
import Reflection from '../components/Reflection.astro';
import Members from '../components/Members.astro';
import Info from '../components/Info.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Navbar />
  <main id="konten">
    <Hero />
    <Highlights />
    <About />
    <Agenda />
    <RouteStepper />
    <Destinations />
    <Documentation />
    <Reflection />
    <Members />
    <Info />
    <Cta />
  </main>
  <Footer />
</Base>
