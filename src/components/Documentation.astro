---
import { catatanIndustri } from '../data/industry-notes';
import { destinasi } from '../data/destinations';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

const galeriSementara = [
  { label: 'Kunjungan industri', kategori: 'industri' },
  { label: 'Perjalanan', kategori: 'perjalanan' },
  { label: 'Kebersamaan', kategori: 'budaya' },
];
---

<section id="kunjungan-industri" class="scroll-mt-24 py-20 sm:py-24">
  <span id="dokumentasi" class="sr-only"></span>
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Dokumentasi</p>
        <h2 id="dokumentasi-judul" class="mt-2 text-h2 text-fg">Catatan belajar dari lapangan</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted sm:text-base">
          Rangkuman pengamatan selama kunjungan industri. Bagian ini akan dilengkapi dengan hasil
          tanya jawab dan refleksi kelompok setelah kegiatan.
        </p>
      </div>
      <p class="shrink-0 self-start rounded-full border border-warning/30 bg-warning-subtle px-4 py-2 text-xs font-medium text-fg">
        2 catatan draf
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        catatanIndustri.map((catatan, index) => {
          const tempat = destinasi.find((item) => item.id === catatan.destinasiId);

          return (
            <article
              id={`catatan-${catatan.destinasiId}`}
              class="flex scroll-mt-24 flex-col rounded-3xl border border-line bg-surface p-6 shadow-soft sm:p-8"
            >
              <div class="flex items-center justify-between gap-4">
                <p class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-brand">
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-brand/5 font-mono text-[10px]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  Kunjungan industri
                </p>
                <span class="rounded-full border border-warning/30 bg-warning-subtle px-2.5 py-1 text-[11px] font-medium text-fg">
                  Draf
                </span>
              </div>

              <h3 class="mt-4 text-h3 text-fg">{tempat?.nama ?? catatan.destinasiId}</h3>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{catatan.profil}</p>

              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <div>
                  <h4 class="text-sm font-semibold text-fg">Yang diamati</h4>
                  <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted marker:text-brand">
                    {catatan.yangDiamati.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-fg">Teknologi</h4>
                  <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-fg-muted marker:text-brand">
                    {catatan.teknologi.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>

              <div class="mt-6 border-t border-line pt-6">
                <h4 class="text-sm font-semibold text-fg">Tanya jawab</h4>
                <div class="mt-3 space-y-4">
                  {catatan.tanyaJawab.map((qa) => (
                    <div>
                      <p class="text-sm font-medium text-fg">
                        <span class="text-brand">T: </span>
                        {qa.tanya}
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-fg-muted">
                        <span class="font-medium text-fg">J: </span>
                        {qa.jawab}
                      </p>
                    </div>
                  ))}
                </div>
              </div>

              <div class="mt-6 rounded-2xl bg-canvas p-4">
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-fg-subtle">Refleksi</p>
                <p class="mt-2 text-sm leading-relaxed text-fg-muted">{catatan.refleksi}</p>
              </div>
            </article>
          );
        })
      }
    </div>

    <div id="galeri" class="mt-16 scroll-mt-24 border-t border-line/70 pt-12">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Galeri</p>
          <h3 class="mt-2 text-h3 text-fg">Potongan perjalanan</h3>
        </div>
        <p class="text-sm text-fg-muted">Foto menyusul setelah kegiatan.</p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          galeriSementara.map((item) => (
            <PhotoPlaceholder
              label={item.label}
              kategori={item.kategori}
              className="aspect-[4/3] w-full rounded-3xl border border-line"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
