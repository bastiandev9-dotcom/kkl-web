---
import { destinasi } from '../data/destinations';
import DestinationCard from './DestinationCard.astro';
import SectionHeader from './SectionHeader.astro';
---

<section id="destinasi" class="scroll-mt-24 bg-surface py-24 sm:py-28 lg:py-32">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeader
        eyebrow="Tempat & kegiatan"
        title="Destinasi yang kami kunjungi"
        description="Kunjungan industri, destinasi wisata, pertunjukan budaya, dan titik perjalanan yang menjadi bagian dari rangkaian KKL."
        titleId="destinasi-judul"
      />
      <p class="shrink-0 self-start rounded-pill border border-line bg-canvas px-4 py-2 text-xs font-medium text-fg-muted">
        {destinasi.length} destinasi
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        destinasi.map((item) => (
          <DestinationCard destinasi={item} />
        ))
      }
    </div>
  </div>
</section>
