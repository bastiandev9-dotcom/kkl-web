---
import { Image } from 'astro:assets';
import type { Destinasi, KategoriDestinasi } from '../data/destinations';
import { formatHari } from '../lib/format';
import { resolvePhoto } from '../lib/images';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  destinasi: Destinasi;
}

const { destinasi } = Astro.props;
const photo = resolvePhoto(destinasi.foto);
const kategoriLabel: Record<KategoriDestinasi, string> = {
  industri: 'Kunjungan industri',
  wisata: 'Wisata',
  budaya: 'Budaya',
  belanja: 'Belanja',
  kuliner: 'Kuliner',
  perjalanan: 'Perjalanan',
};
---

<article
  id={`destinasi-${destinasi.id}`}
  class="group flex scroll-mt-24 flex-col overflow-hidden rounded-3xl border border-line bg-canvas shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand/25 hover:shadow-xl"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Foto ${destinasi.nama}`}
          widths={[400, 720]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      ) : (
        <PhotoPlaceholder
          label={destinasi.nama}
          kategori={destinasi.kategori}
          showLabel={false}
          className="h-full w-full transition-transform duration-500 group-hover:scale-[1.04]"
        />
      )
    }
    <span class="absolute left-4 top-4 rounded-full border border-white/50 bg-white/85 px-3 py-1 text-[11px] font-semibold text-fg backdrop-blur-md">
      {kategoriLabel[destinasi.kategori]}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-4 text-xs text-fg-muted">
      <span class="flex items-center gap-1.5 font-medium">
        <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="3"></rect>
          <path d="M8 3v4M16 3v4M3 10h18" stroke-linecap="round"></path>
        </svg>
        {formatHari(destinasi.hari)}
      </span>
      {destinasi.model3d && (
        <span class="rounded-full bg-brand/5 px-2.5 py-1 text-[10px] font-semibold text-brand">
          3D
        </span>
      )}
    </div>

    <h3 class="mt-3 text-h4 text-fg">{destinasi.nama}</h3>
    <p class="mt-2 text-sm leading-relaxed text-fg-muted">{destinasi.deskripsi}</p>

    {
      destinasi.catatanBelajar && (
        <p class="mt-auto border-t border-line/80 pt-4 text-xs leading-relaxed text-fg-muted">
          <span class="font-semibold text-fg">Catatan belajar: </span>
          {destinasi.catatanBelajar}
        </p>
      )
    }
  </div>
</article>
