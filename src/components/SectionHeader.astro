---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  titleId?: string;
}

const { eyebrow, title, description, titleId } = Astro.props;
---

<div class="max-w-2xl">
  <p class="text-label uppercase text-brand">{eyebrow}</p>
  <h2 id={titleId} class="mt-3 text-balance text-h2 text-fg">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-fg-muted">{description}</p>}
</div>
