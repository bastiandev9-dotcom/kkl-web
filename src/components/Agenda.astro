---
import { agenda } from '../data/agenda';
import { info } from '../data/info';
import AgendaTabs from './vue/AgendaTabs.vue';
import SectionHeader from './SectionHeader.astro';
---

<section id="agenda" class="scroll-mt-24 bg-surface py-24 sm:py-28 lg:py-32">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeader
        eyebrow="Rangkaian acara"
        title="Agenda lima hari"
        description="Susunan kegiatan KKL Bali 2026 dari keberangkatan hingga kembali ke Semarang. Jam dan urutan mengikuti jadwal perjalanan."
        titleId="agenda-judul"
      />
      <p class="shrink-0 self-start rounded-pill border border-line bg-canvas px-4 py-2 text-xs font-medium text-fg-muted">
        18-22 Agustus 2026
      </p>
    </div>

    <p class="mt-8 rounded-lg border border-warning/30 bg-warning-subtle px-4 py-3 text-sm leading-relaxed text-fg">
      {info.catatan}
    </p>

    <div class="mt-6">
      <AgendaTabs client:visible days={agenda} />
    </div>
  </div>
</section>
