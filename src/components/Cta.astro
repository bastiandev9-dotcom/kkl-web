---
---

<section id="ebooklet" class="mx-auto max-w-7xl px-6 py-16">
  <div
    class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand to-brand-dark p-8 text-white shadow-floating md:p-14"
  >
    <div class="pointer-events-none absolute -bottom-10 -right-10 h-64 w-64 rounded-full bg-white/5" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-10 -top-10 h-48 w-48 rounded-full bg-accent/10" aria-hidden="true"></div>

    <div class="relative z-10 max-w-2xl">
      <span class="mb-4 inline-block rounded-full bg-accent px-3 py-1 text-xs font-bold text-brand-dark">
        Buku Panduan &amp; Dokumentasi Lengkap
      </span>
      <h2 class="mb-4 text-2xl font-extrabold tracking-tight md:text-4xl">
        Unduh E-Booklet &amp; Foto Resolusi Penuh
      </h2>
      <p class="mb-8 text-sm leading-relaxed text-white/80 md:text-base">
        Dapatkan file laporan resmi KKL, dokumentasi potret kegiatan beresolusi tinggi, serta modul
        studi kasus industri secara gratis.
      </p>

      <form class="flex max-w-md flex-col gap-3 sm:flex-row" data-ebook-form>
        <label class="sr-only" for="ebook-email">Alamat email kampus</label>
        <input
          id="ebook-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="Masukkan alamat email kampus..."
          class="flex-1 rounded-full border-0 bg-white px-5 py-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-accent"
        />
        <button
          type="submit"
          class="whitespace-nowrap rounded-full bg-accent px-6 py-3 text-sm font-bold text-brand-dark shadow-md transition-colors hover:bg-accent-hover"
        >
          Unduh Dokumen
        </button>
      </form>
      <p class="mt-3 hidden text-xs text-white/75" data-ebook-status aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-ebook-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('[data-ebook-status]');

      if (!status) {
        return;
      }

      status.textContent =
        'E-booklet belum tersedia. Silakan cek kembali setelah kegiatan KKL selesai.';
      status.classList.remove('hidden');
    });
  });
</script>
