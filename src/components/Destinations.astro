---
import { destinasi } from '../data/destinations';
import DestinationCard from './DestinationCard.astro';
---

<section id="wisata-budaya" class="scroll-mt-24 border-y border-line/70 bg-surface py-20 sm:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Tempat & kegiatan</p>
        <h2 id="destinasi-judul" class="mt-2 text-h2 text-fg">Destinasi yang kami kunjungi</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted sm:text-base">
          Kunjungan industri, destinasi wisata, pertunjukan budaya, dan titik perjalanan yang
          menjadi bagian dari rangkaian KKL.
        </p>
      </div>
      <p class="shrink-0 self-start rounded-full border border-line bg-canvas px-4 py-2 text-xs font-medium text-fg-muted">
        {destinasi.length} destinasi
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        destinasi.map((item) => (
          <DestinationCard destinasi={item} />
        ))
      }
    </div>
  </div>
</section>
