---
import { Image } from 'astro:assets';
import type { Destinasi, KategoriDestinasi } from '../data/destinations';
import type { JenisKegiatan } from '../data/agenda';
import { formatHari } from '../lib/format';
import { resolvePhoto } from '../lib/images';
import ActivityBadge from './ActivityBadge.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  destinasi: Destinasi;
}

const { destinasi } = Astro.props;
const photo = resolvePhoto(destinasi.foto);
const jenisMap: Record<KategoriDestinasi, JenisKegiatan> = {
  industri: 'kunjungan',
  wisata: 'wisata',
  budaya: 'budaya',
  belanja: 'belanja',
  kuliner: 'makan',
  perjalanan: 'perjalanan',
};
const jenis = jenisMap[destinasi.kategori];
---

<article
  id={`destinasi-${destinasi.id}`}
  class="group scroll-mt-24 overflow-hidden rounded-xl border border-line bg-canvas transition-transform duration-200 hover:-translate-y-0.5"
>
  <div class="aspect-[4/3] overflow-hidden">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Foto ${destinasi.nama}`}
          widths={[400, 720]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <PhotoPlaceholder
          label={destinasi.nama}
          kategori={destinasi.kategori}
          className="h-full w-full"
        />
      )
    }
  </div>
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-2">
      <ActivityBadge jenis={jenis} />
      <span class="text-xs text-fg-muted">{formatHari(destinasi.hari)}</span>
    </div>
    <h3 class="mt-3 text-h4 text-fg">{destinasi.nama}</h3>
    <p class="mt-2 text-sm leading-relaxed text-fg-muted">{destinasi.deskripsi}</p>
    {
      destinasi.catatanBelajar && (
        <p class="mt-4 border-t border-line pt-4 text-sm leading-relaxed text-fg-muted">
          <span class="font-medium text-fg">Catatan belajar: </span>
          {destinasi.catatanBelajar}
        </p>
      )
    }
  </div>
</article>
