---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Agenda from '../components/Agenda.astro';
import RouteStepper from '../components/RouteStepper.astro';
import Destinations from '../components/Destinations.astro';
import Documentation from '../components/Documentation.astro';
import Members from '../components/Members.astro';
import Info from '../components/Info.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Navbar />
  <main id="konten">
    <Hero />
    <About />
    <Stats />
    <Agenda />
    <RouteStepper />
    <Destinations />
    <Documentation />
    <Members />
    <Info />
  </main>
  <Footer />
</Base>
