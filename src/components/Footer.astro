---
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import Icon from './ui/Icon.astro';
---

<footer class="mt-20 border-t border-neutral-200 bg-white pb-12 pt-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="mb-4 block w-fit text-xl font-black tracking-wider text-brand">
          {site.brand}
        </a>
        <p class="mb-6 max-w-sm text-sm leading-relaxed text-neutral-500">
          Portal dokumentasi resmi Kuliah Kerja Lapangan (KKL) Program Studi Informatika, Fakultas
          Teknik dan Informatika, Universitas PGRI Semarang (UPGRIS).
        </p>
        <div class="flex items-center gap-3 text-neutral-400">
          <span class="sr-only">Media sosial segera hadir</span>
          <span
            class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 bg-[#fafaf4]"
            aria-hidden="true"
          >
            <Icon name="instagram" class="h-4 w-4" strokeWidth={1.8} />
          </span>
          <span
            class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 bg-[#fafaf4]"
            aria-hidden="true"
          >
            <Icon name="globe" class="h-4 w-4" strokeWidth={1.8} />
          </span>
          <span
            class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 bg-[#fafaf4]"
            aria-hidden="true"
          >
            <Icon name="youtube" class="h-4 w-4" strokeWidth={1.8} />
          </span>
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-neutral-800">Eksplorasi</h2>
        <ul class="space-y-2 text-sm text-neutral-600">
          {
            navigation.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-brand">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-neutral-800">Sekretariat</h2>
        <address class="mb-3 text-xs not-italic leading-relaxed text-neutral-500">
          {site.alamat}.
        </address>
        <a href={`mailto:${site.email}`} class="block text-xs font-semibold text-brand">
          {site.email}
        </a>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-neutral-200 pt-8 text-xs text-neutral-400 md:flex-row"
    >
      <p>&copy; 2026 KARYAWISATA Informatika UPGRIS. Seluruh hak cipta dilindungi.</p>
      <p>Dirancang untuk Dokumentasi KKL 18–22 Agustus 2026</p>
    </div>
  </div>
</footer>
