---
import { agenda } from '../data/agenda';
import { destinasi } from '../data/destinations';
import { site } from '../data/site';
import HeroScene from './vue/HeroScene.vue';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

const show3d = site.heroModel === 'ulun-danu' || site.heroModel === 'candi-bentar';
const jumlahKunjungan = agenda
  .flatMap((hari) => hari.item)
  .filter((item) => item.jenis === 'kunjungan').length;
const jumlahDestinasi = destinasi.filter(
  (item) => item.kategori === 'wisata' || item.kategori === 'budaya',
).length;
const facts = [
  { label: 'Tanggal', value: '18-22 Agu 2026' },
  { label: 'Rute', value: 'Semarang - Bali' },
  { label: 'Prodi', value: 'Informatika' },
  { label: 'Instansi', value: 'UPGRIS' },
];
const stats = [
  { value: agenda.length, label: 'Hari', detail: 'Perjalanan' },
  { value: jumlahKunjungan, label: 'Industri', detail: 'Kunjungan' },
  { value: jumlahDestinasi, label: 'Destinasi', detail: 'Wisata & budaya' },
];
---

<section id="beranda" class="relative scroll-mt-24 overflow-hidden pb-14 pt-4 sm:pb-20">
  <div
    class="pointer-events-none absolute -right-48 -top-32 h-[34rem] w-[34rem] rounded-full bg-accent/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-56 top-1/2 h-[30rem] w-[30rem] rounded-full bg-brand/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative">
    <div class="grid items-center gap-10 pb-10 pt-6 lg:grid-cols-12 lg:gap-8 lg:pb-14 lg:pt-10">
      <div class="lg:col-span-7 lg:pr-6">
        <p
          class="inline-flex w-fit items-center gap-2 rounded-full border border-brand/15 bg-brand/10 px-4 py-1.5 text-xs font-semibold text-brand"
        >
          <span class="h-2 w-2 rounded-full bg-[#9ad84f] ring-4 ring-accent/40" aria-hidden="true"></span>
          18-22 Agustus 2026 - Bali
        </p>

        <p class="mt-6 text-[11px] font-bold uppercase tracking-[0.18em] text-brand sm:text-xs">
          KKL Informatika UPGRIS 2026
        </p>
        <h1 class="mt-2 max-w-3xl text-display text-fg" aria-label={site.tagline}>
          Jelajah Wawasan<span class="hidden sm:inline">&nbsp;&</span><br />
          <span class="text-brand"><span class="mr-2 sm:hidden" aria-hidden="true">&</span>Pesona Dewata</span>
        </h1>

        <p class="mt-6 max-w-xl text-sm leading-relaxed text-fg-muted sm:text-base">
          Dokumentasi perjalanan KKL mahasiswa Informatika UPGRIS ke Bali, merangkum setiap momen
          berharga dari ruang produksi industri modern, eksplorasi destinasi ikonik, hingga
          perjumpaan dengan budaya nusantara.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#eksplorasi"
            class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-on-brand shadow-md transition-all hover:-translate-y-0.5 hover:bg-brand-hover hover:shadow-lg"
          >
            Jelajahi Dokumentasi
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="#jadwal"
            class="inline-flex items-center rounded-full border border-fg/15 bg-surface px-6 py-3.5 text-sm font-medium text-fg shadow-xs transition-colors hover:border-brand/40 hover:text-brand"
          >
            Lihat Itinerary
          </a>
        </div>

        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-4">
          {
            facts.map((fact) => (
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">
                  {fact.label}
                </dt>
                <dd class="mt-1.5 text-xs font-bold text-fg sm:text-sm">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="mx-auto w-full max-w-lg lg:max-w-none">
          <div class="mb-3 flex items-center justify-between gap-3 px-1">
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-brand/15 bg-brand/10 px-3 py-1 text-[11px] font-semibold text-brand"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" stroke-linejoin="round"></path>
                <path d="m4 7.5 8 4.5 8-4.5M12 12v9" stroke-linejoin="round"></path>
              </svg>
              3D Model Interaktif
            </span>
            <span class="flex items-center gap-1.5 text-[11px] font-medium text-fg-muted">
              <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
              Ulun Danu Beratan
            </span>
          </div>

          <div id="model-3d" class="relative scroll-mt-28">
            {
              show3d ? (
                <HeroScene client:load model={site.heroModel} />
              ) : (
                <PhotoPlaceholder
                  label="Ulun Danu Beratan"
                  kategori="wisata"
                  className="aspect-square w-full rounded-3xl border border-line"
                />
              )
            }
          </div>

          <p class="mt-3 text-center text-[11px] font-medium text-fg-subtle">
            Visual 3D Ulun Danu Beratan
          </p>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-4xl">
      <div class="grid gap-4 sm:grid-cols-3">
        {
          stats.map((stat, index) => (
            <div class="group flex items-center justify-between rounded-3xl border border-line/80 bg-surface p-5 shadow-soft transition-transform duration-200 hover:-translate-y-1">
              <div class="flex items-baseline gap-3">
                <span class="text-4xl font-black tracking-tight text-fg">{stat.value}</span>
                <span class="leading-tight">
                  <span class="block text-sm font-bold text-fg sm:text-base">{stat.label}</span>
                  <span class="block text-[11px] font-medium text-fg-subtle">{stat.detail}</span>
                </span>
              </div>
              <span
                class:list={[
                  'grid h-9 w-9 place-items-center rounded-xl bg-brand/5 text-[#556b2f]',
                  index === 0 && 'text-brand',
                ]}
                aria-hidden="true"
              >
                {index === 0 && <span class="h-3.5 w-3.5 rounded-full bg-[#9ad84f] ring-4 ring-accent/40"></span>}
                {index === 1 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M3 21h18M5 21V10l4-2v13M9 21V7l6-3v17M15 21v-7l4-2v9" stroke-linejoin="round"></path>
                  </svg>
                )}
                {index === 2 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M3 20h18L14 9l-3 5-2-3-6 9Z" stroke-linejoin="round"></path>
                    <path d="M17 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path>
                  </svg>
                )}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
