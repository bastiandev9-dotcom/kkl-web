---
import { agenda } from '../data/agenda';
import { info } from '../data/info';
import AgendaTabs from './vue/AgendaTabs.vue';
---

<section id="jadwal" class="scroll-mt-24 border-y border-line/70 bg-surface py-20 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand">Rencana itinerary</p>
      <h2 class="mt-2 text-h2 text-fg">Jadwal 5 hari kegiatan KKL</h2>
      <p class="mt-4 text-sm leading-relaxed text-fg-muted sm:text-base">
        Susunan agenda dari keberangkatan kampus, studi lapangan, hingga perjalanan kembali.
        Pilih hari untuk melihat jam dan urutan kegiatan.
      </p>
    </div>

    <div class="mt-8 flex items-start gap-2.5 rounded-2xl border border-warning/25 bg-warning-subtle/70 px-4 py-3 text-xs leading-relaxed text-fg sm:mx-auto sm:max-w-3xl sm:text-sm">
      <svg class="mt-0.5 h-4 w-4 shrink-0 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 8v5M12 16.5h.01" stroke-linecap="round"></path>
      </svg>
      <p>{info.catatan}</p>
    </div>

    <div class="mt-8">
      <AgendaTabs client:visible days={agenda} />
    </div>
  </div>
</section>
